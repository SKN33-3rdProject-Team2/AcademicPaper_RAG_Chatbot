# ============================================
# Local LLM - Ollama
# ============================================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b


# ============================================
# Embedding
# ============================================

EMBEDDING_MODEL=BAAI/bge-m3


# ============================================
# LangSmith
# ============================================

# LangSmith 추적 사용 여부
LANGSMITH_TRACING=false

# 실제 API 키는 각 팀원의 .env 파일에만 입력
LANGSMITH_API_KEY=

# LangSmith 프로젝트 이름
LANGSMITH_PROJECT=academic-paper-rag-chatbot

# 기본 리전 외의 LangSmith 서버를 사용할 때만 설정
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# API 키가 여러 Workspace에 연결된 경우에만 설정
# LANGSMITH_WORKSPACE_ID=


# ============================================
# NVIDIA API Catalog
# ============================================

# NVIDIA Build API 또는 NVIDIA AI Endpoint 사용 시 입력
NVIDIA_API_KEY=
